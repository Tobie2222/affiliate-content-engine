# Chỉ chứa giá trị mẫu. KHÔNG commit file .env thật.
# Sao chép: cp .env.example .env  rồi thay các giá trị CHANGE_ME.

NODE_ENV=development
PORT=3000
# api | worker | all  (worker dùng từ Phase 5)
APP_ROLE=all

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ace
DB_PASSWORD=CHANGE_ME_postgres_password
DB_NAME=ace

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# MinIO (S3 tương thích, chỉ dùng khi dev)
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_min8

# Xác thực. Tạo khóa ký ngẫu nhiên (>= 32 ký tự), ví dụ:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_random_secret_of_32_chars_or_more
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Origin frontend được phép gọi API, cách nhau bằng dấu phẩy. Ví dụ: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Chế độ adapter: mock | official
# "mock" là dữ liệu giả để dev, KHÔNG phải tích hợp thật.
LLM_PROVIDER=mock
SHOPEE_PROVIDER=mock
THREADS_PROVIDER=mock
